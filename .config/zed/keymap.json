// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"context": "Workspace || Editor",
		"bindings": {
			"shift shift": "file_finder::Toggle",
			"ctrl-b": "workspace::ToggleRightDock",
			"ctrl-j": "workspace::ToggleBottomDock",
			"ctrl-w": "pane::CloseActiveItem",
		},
	},
	{
		"context": "Workspace",
		"bindings": {
			"shift shift": "file_finder::Toggle",
			"ctrl-shift-e": "project_panel::ToggleFocus",
			"ctrl-shift-b": "outline_panel::ToggleFocus",
			"ctrl-shift-g": "git_panel::ToggleFocus",
			"ctrl-shift-d": "debug_panel::Toggle",
			"ctrl-alt-b": "workspace::ToggleLeftDock",
		},
	},
	{
		"context": "Editor",
		"bindings": {
			"alt-shift-f": "editor::Format",
			// "alt-j": "terminal_panel::Toggle",
			// "ctrl-j": "terminal_panel::ToggleFocus",
			"ctrl-alt-b": "editor::ToggleGitBlameInline",
		},
	},
	{
		"context": "Terminal",
		"bindings": {
			"Alt-J": "workspace::ToggleZoom",
			"ctrl-k": "editor::ToggleFocus",
		},
	},
	// {
	// 	"context": "vim_mode == literal",
	// 	"bindings": {
	// 		"ctrl-b": ["vim::Literal", ["ctrl-b", "\u0002"]],
	// 	},
	// },
	{
		"context": "vim_mode == literal",
		"unbind": {
			"ctrl-b": ["vim::Literal", ["ctrl-b", "\u0002"]],
		},
	},
	{
		"context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
		"bindings": {
			"alt-k": "editor::MoveLineUp",
			"[ e": "editor::MoveLineUp",
			"alt-j": "editor::MoveLineDown",
			"] e": "editor::MoveLineDown",
		},
	},
]
